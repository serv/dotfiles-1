# Homebrew, Mac Only
export PATH=/opt/homebrew/bin:$PATH

###
#
# rbenv
#
###

# https://github.com/sstephenson/rbenv#uninstalling-rbenv
export PATH="$HOME/.rbenv/bin:$PATH"
eval "$(rbenv init -)"

###
#
# python
#
###

export PATH="$HOME/.pyenv/bin:$PATH"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"

###
#
# golang
#
###

if [ "$(uname)" == "Darwin" ]; then
  :
elif [ "$(expr substr $(uname -s) 1 5)" == "Linux" ]; then
  export PATH=$PATH:/usr/local/go/bin
fi

export GOPATH=$HOME/projects/golang
export PATH="$GOPATH/bin:$PATH"


###
#
# git
#
###

# Fast git commands
alias gs='git status'
alias gd='git diff'

# Enable autocompletion on git commands and branch names
# http://code-worrier.com/blog/autocomplete-git/
if [ -f ~/.git-completion.bash ]; then
  . ~/.git-completion.bash
fi

###
#
# node
#
###

# Set node environment variable
export NODE_ENV=development

# Aliases for node
alias mocha='node_modules/mocha/bin/mocha'
alias gulp='node_modules/gulp/bin/gulp.js'

# Use NVM

# Detect if the shell is interactive
if [[ $- == *i* ]]; then
  export INTERACTIVE_SHELL=1
else
  export INTERACTIVE_SHELL=0
fi

export NVM_DIR="$HOME/.nvm"

# Fast Node.js path resolver (runs in <1ms)
# Directly prepends the appropriate pre-installed node version bin folder to PATH
resolve_and_prepend_nvm_path() {
  local nvmrc_path=""
  local dir="$PWD"

  # Search upward for .nvmrc
  while [ "$dir" != "" ]; do
    if [ -s "$dir/.nvmrc" ] && [ -r "$dir/.nvmrc" ]; then
      nvmrc_path="$dir/.nvmrc"
      break
    fi
    if [ "$dir" = "/" ]; then
      break
    fi
    dir="$(dirname "$dir")"
  done

  local requested_version=""
  if [ -n "$nvmrc_path" ]; then
    requested_version=$(<"$nvmrc_path")
  else
    # Fall back to default alias file
    if [ -s "$NVM_DIR/alias/default" ]; then
      requested_version=$(<"$NVM_DIR/alias/default")
    fi
  fi

  # Clean the requested version (strip leading 'v', spaces, and newlines)
  requested_version="${requested_version#v}"
  requested_version="${requested_version//[[:space:]]/}"

  # If it is 'node' or 'stable', we treat it as empty to find the latest available
  if [ "$requested_version" = "node" ] || [ "$requested_version" = "stable" ]; then
    requested_version=""
  fi

  if [ -n "$requested_version" ] || [ -d "$NVM_DIR/versions/node" ]; then
    # Find the latest matching version in ~/.nvm/versions/node/
    local best_match=""
    for d in "$NVM_DIR/versions/node/v${requested_version}"*; do
      if [ -d "$d/bin" ]; then
        best_match="$d"
      fi
    done

    if [ -n "$best_match" ]; then
      # Clean current NVM paths from PATH to avoid endless accumulation
      PATH=$(echo "$PATH" | tr ':' '\n' | grep -v '\.nvm/versions/node/' | tr '\n' ':' | sed 's/:$//')
      export PATH="$best_match/bin:$PATH"
      return 0
    fi
  fi
  return 1
}

# Lazy load function for the full NVM script (only run on demand)
lazy_load_nvm() {
  # Remove the placeholder functions so we don't recurse
  unset -f nvm node npm npx
  
  # Load actual NVM
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}

# Placeholders for manual invocation in interactive sessions
if [ "$INTERACTIVE_SHELL" -eq 1 ]; then
  nvm() {
    lazy_load_nvm
    nvm "$@"
  }
  node() {
    lazy_load_nvm
    node "$@"
  }
  npm() {
    lazy_load_nvm
    npm "$@"
  }
  npx() {
    lazy_load_nvm
    npx "$@"
  }
fi

# Deep integration / cd override
cdnvm() {
  command cd "$@" || return $?
  
  # Try the instant resolver first
  if resolve_and_prepend_nvm_path; then
    return 0
  fi

  # Fallback to loading full NVM if the version couldn't be resolved locally
  lazy_load_nvm
  
  # Run the original cdnvm logic as fallback
  local nvm_path
  nvm_path="$(nvm_find_up .nvmrc | command tr -d '\n')"
  if [[ ! $nvm_path = *[^[:space:]]* ]]; then
    local default_version
    default_version="$(nvm version default)"
    if [ "$default_version" = 'N/A' ]; then
      nvm alias default node
      default_version=$(nvm version default)
    fi
    if [ "$(nvm current)" != "${default_version}" ]; then
      nvm use default
    fi
  elif [[ -s "${nvm_path}/.nvmrc" && -r "${nvm_path}/.nvmrc" ]]; then
    local nvm_version
    nvm_version=$(<"${nvm_path}"/.nvmrc)
    local locally_resolved_nvm_version
    locally_resolved_nvm_version=$(nvm ls --no-colors "${nvm_version}" | command tail -1 | command tr -d '\->*' | command tr -d '[:space:]')
    if [ "${locally_resolved_nvm_version}" = 'N/A' ]; then
      nvm install "${nvm_version}";
    elif [ "$(nvm current)" != "${locally_resolved_nvm_version}" ]; then
      nvm use "${nvm_version}";
    fi
  fi
}

alias cd='cdnvm'

# Initial resolution on startup
resolve_and_prepend_nvm_path || {
  # If resolving fails and shell is interactive, load full NVM
  if [ "$INTERACTIVE_SHELL" -eq 1 ]; then
    lazy_load_nvm
    cdnvm "$PWD" || exit
  fi
}

###
#
# ssh
#
###

# add ssh-agents
ssh-add ~/.ssh/gitlab &> /dev/null
ssh-add ~/.ssh/id_dsa &> /dev/null
ssh-add ~/.ssh/github &> /dev/null

###
#
# java environments
#
###

JENV=~/.jenv
if [ -d "$JENV" ]; then
  export PATH="$HOME/.jenv/bin:$PATH"
  eval "$(jenv init -)"
fi

###
#
# Ubuntu
#
###

if [ "$(uname)" == "Darwin" ]; then
  :
elif [ "$(expr substr $(uname -s) 1 5)" == "Linux" ]; then
  alias open=nautilus
fi

# Enpass
# https://discussion.enpass.io/index.php?/topic/26668-the-enpass-app-overflows-beyond-the-viewable-area/&tab=comments#comment-73359

export "QT_SCREEN_SCALE_FACTORS=1.5.1.5"
export "QT_SCREEN_SCALE_FACTORS=2.0,2.0"

# pnpm
# https://github.com/pnpm/pnpm/issues/4658
export PATH="$HOME/pnpm:$PATH"
export PNPM_HOME="$HOME/pnpm"

# For Terraform
# Running $ terraform -install-autocomplete
# https://developer.hashicorp.com/terraform/tutorials/azure-get-started/install-cli
complete -C /opt/homebrew/bin/terraform terraform

# opencode
export PATH=/Users/jasonkim/.opencode/bin:$PATH

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"